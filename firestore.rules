rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Item 7: Admin verification exclusively via Custom Claims or admins/{uid} with email_verified requirement
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'ADMIN' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlanLevel(level) {
      return level is int && level >= 1 && level <= 4;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (
        (
          isOwner(userId) &&
          request.resource.data.role == 'USER' &&
          request.resource.data.nivel_plano == 1 &&
          request.resource.data.status_plano == 'ATIVO' &&
          (!('status_licenca' in request.resource.data) || request.resource.data.status_licenca in ['INATIVA', 'PENDENTE', 'SEM_LICENCA', 'ATIVA']) &&
          (!('license_id' in request.resource.data) || request.resource.data.license_id == null || request.resource.data.license_id == '')
        ) ||
        (isAdmin() && isValidPlanLevel(request.resource.data.nivel_plano))
      );
      // Item 6: Replace blocklist with strict hasOnly whitelist for owner updates
      allow update: if (isAdmin() && (!('nivel_plano' in request.resource.data) || isValidPlanLevel(request.resource.data.nivel_plano))) || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'device_id',
          'ultimo_login',
          'avatar',
          'updated_at'
        ])
      );
      allow delete: if isAdmin();
    }

    // Admin Whitelist (Strictly restricted to Admin authority)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Licenses Collection
    match /licenses/{licenseId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Devices Collection
    match /devices/{deviceId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      // Item 6: Verify current document ownership (resource.data.user_id) to prevent device hijacking
      allow update: if isSignedIn() && (
        (resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Execution Tokens Registry
    match /executions/{executionId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Optimization History
    match /optimization_history/{historyId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Admin Logs
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // App Configuration
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
